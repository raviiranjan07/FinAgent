# FinAgent Environment Configuration
# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=finagent
POSTGRES_USER=finagent
POSTGRES_PASSWORD=finagent_secret

# Full database URL (used by Python app)
DATABASE_URL=postgresql://finagent:finagent_secret@localhost:5432/finagent

# Enable SQL query logging (for debugging)
SQL_DEBUG=false

# Enable database adapter in pipeline (set to true when PostgreSQL is running)
DATABASE_ENABLED=true

# =============================================================================
# Ollama Configuration (Local LLM)
# =============================================================================
OLLAMA_URL=http://localhost:11434
MODEL_NAME=llama3

# LLM settings
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# =============================================================================
# LLM API Configuration (Gemini / Groq / Ollama)
# =============================================================================
# LLM Mode: "gemini", "groq", or "ollama"
# - "gemini": Use Google Gemini as primary (recommended, free tier: 15 RPM, 1500 RPD)
# - "groq": Use Groq as primary (free tier: 14,400 RPD)
# - "ollama": Use local Ollama (unlimited, requires ollama serve)
LLM_MODE=gemini

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# Google Gemini API Configuration (Direct API access)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PRIMARY_MODEL=gemma-3-27b-it

# Fallback Configuration
# Enable fallback chain (depends on LLM_MODE):
# - LLM_MODE=gemini: Gemini → Groq → Ollama
# - LLM_MODE=groq: Groq → Gemini → Ollama
# - LLM_MODE=ollama: Ollama only (no fallback)
LLM_ENABLE_GEMINI_FALLBACK=true
LLM_ENABLE_OLLAMA_FALLBACK=true

# =============================================================================
# Twitter Content Generation LLM Settings
# =============================================================================
# Mode: "gemini", "groq", or "ollama" (uses same fallback chain as main LLM)
TWITTER_CONTENT_MODE=groq
TWITTER_CONTENT_MODEL=qwen/qwen3-32b
TWITTER_LLM_TIMEOUT=45

# =============================================================================
# Application Settings
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum events to fetch per RSS source
MAX_EVENTS_PER_SOURCE=5

# =============================================================================
# Twitter/X API v2 Configuration
# =============================================================================
# Twitter API v2 credentials (OAuth 1.0a User Context)
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Twitter Bearer Token (for read-only operations, optional)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Twitter Publishing Configuration
TWITTER_PUBLISHING_ENABLED=true
TWITTER_DRY_RUN=true
TWITTER_PLUGIN_ENABLED=true

# =============================================================================
# Twitter Publishing Worker Configuration (APScheduler)
# =============================================================================
# How often worker checks for scheduled content (in seconds)
WORKER_CHECK_INTERVAL=60

# Maximum number of retry attempts for failed publishes
WORKER_MAX_RETRIES=3

# Worker lock file location (prevents duplicate workers)
# Windows: Use C:\temp\ or C:\Users\<username>\temp\
# Linux: Use /tmp/
WORKER_LOCK_FILE=C:\temp\twitter_worker.lock

# Worker heartbeat file location (for health monitoring)
WORKER_HEARTBEAT_FILE=C:\temp\twitter_worker_heartbeat.txt
