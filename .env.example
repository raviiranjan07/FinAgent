# =============================================================================
# FinAgent Environment Configuration
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the project root
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
#
# 2. Update the values below according to your setup
#
# 3. NEVER commit the .env file to version control (it's in .gitignore)
#
# REQUIRED FOR BASIC OPERATION:
# - DATABASE_URL (PostgreSQL connection)
# - LLM_MODE and corresponding API key (GEMINI_API_KEY or OPENROUTER_API_KEY)
#
# OPTIONAL BUT RECOMMENDED:
# - TWITTER_* credentials (for content publishing)
# - QUOTA_* settings (to track API usage)
# =============================================================================

# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=finagent
POSTGRES_USER=finagent
POSTGRES_PASSWORD=finagent_secret

# Full database URL (used by Python app)
DATABASE_URL=postgresql://finagent:finagent_secret@localhost:5432/finagent

# Enable SQL query logging (for debugging)
SQL_DEBUG=false

# Enable database adapter in pipeline (set to true when PostgreSQL is running)
DATABASE_ENABLED=false

# =============================================================================
# Main Pipeline LLM Configuration
# =============================================================================
# LLM Mode: "openrouter" (OpenRouter API), "gemini" (Google Gemini), or "ollama" (local)
LLM_MODE=gemini

# OpenRouter API Configuration (when LLM_MODE=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_APP_NAME=FinAgent

# Google Gemini API Configuration (when LLM_MODE=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Ollama Configuration (when LLM_MODE=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=all-minilm

# General LLM Settings
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# Fallback configuration
LLM_ENABLE_GEMINI_FALLBACK=true
LLM_ENABLE_OLLAMA_FALLBACK=true

# =============================================================================
# Application Settings
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum events to fetch per RSS source
MAX_EVENTS_PER_SOURCE=5

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dashboard Configuration
DASHBOARD_PORT=5173
DASHBOARD_URL=http://localhost:5173

# WebSocket Configuration
WEBSOCKET_ENABLED=true

# =============================================================================
# Content Generation Settings
# =============================================================================
# Twitter content character limits
TWITTER_MAX_LENGTH=280
TWITTER_TARGET_LENGTH=260

# Content queue default status
DEFAULT_CONTENT_STATUS=pending

# =============================================================================
# Quota Management
# =============================================================================
# Auto-heal quota scheduler interval (minutes)
QUOTA_HEAL_INTERVAL=5

# Quota limits per provider
GEMINI_MONTHLY_LIMIT=1500
OPENROUTER_MONTHLY_LIMIT=1000

# Quota tracking enabled
QUOTA_TRACKING_ENABLED=true

# =============================================================================
# Smart Scheduler Settings
# =============================================================================
# Timezone for scheduling (IST)
SCHEDULER_TIMEZONE=Asia/Kolkata

# Posts per day range
MIN_POSTS_PER_DAY=3
MAX_POSTS_PER_DAY=8

# Gap between posts (hours)
MIN_GAP_HOURS=1.5
MAX_GAP_HOURS=3.5

# Time jitter for human-like behavior (minutes)
MIN_TIME_JITTER_MINUTES=-15
MAX_TIME_JITTER_MINUTES=30

# Skip day probability (0.0 to 1.0)
SKIP_DAY_PROBABILITY=0.15

# =============================================================================
# Pre-MVP/MVP Settings
# =============================================================================
# Content approval workflow
REQUIRE_APPROVAL=true

# HITL (Human-in-the-Loop) Configuration
HITL_ENABLED=true
HITL_AGREEMENT_THRESHOLD=0.90

# Pipeline Configuration
PIPELINE_ENABLE_DEDUPLICATION=true
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85

# Content validation
ENABLE_CONTENT_VALIDATION=false

# =============================================================================
# Twitter Content Generation LLM Configuration (Optional - defaults to main pipeline)
# =============================================================================
# Use separate LLM for Twitter content generation (e.g., cheaper/faster model)
# If not set, will use the main pipeline LLM configuration above

# TWITTER_CONTENT_MODE=openrouter  # Override main LLM_MODE for Twitter
# TWITTER_CONTENT_MODEL=gemini-2.5-flash-lite  # Generic model name (faster, cheaper)
# TWITTER_LLM_TIMEOUT=45  # Shorter timeout for Twitter (simpler tasks)
# TWITTER_LLM_MAX_RETRIES=2  # Fewer retries for Twitter

# =============================================================================
# Twitter/X API v2 Configuration
# =============================================================================
# Twitter API v2 credentials (OAuth 1.0a User Context)
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Twitter Bearer Token (for read-only operations, optional)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Twitter Publishing Configuration
TWITTER_PUBLISHING_ENABLED=false
TWITTER_DRY_RUN=true

# Twitter Dual-Format Generation
TWITTER_DUAL_FORMAT_ENABLED=true
TWITTER_GENERATE_SINGLE=true
TWITTER_GENERATE_THREAD=true

# Twitter Content Style
TWITTER_CONTENT_STYLE=analytical  # Options: analytical, educational, neutral

# =============================================================================
# LinkedIn API Configuration (Future)
# =============================================================================
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# =============================================================================
# Development & Debugging
# =============================================================================
# Development mode (enables extra logging, hot reload, etc.)
DEV_MODE=true

# Skip LLM calls for testing (uses mock responses)
SKIP_LLM_CALLS=false

# Verbose logging for adapters
ADAPTER_VERBOSE_LOGGING=false

# Enable request/response logging in API
API_LOG_REQUESTS=false

# =============================================================================
# Security & Rate Limiting
# =============================================================================
# API rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Enable API key authentication (future)
API_KEY_REQUIRED=false

# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# =============================================================================
# Monitoring & Analytics (Future)
# =============================================================================
# Enable analytics tracking
# ANALYTICS_ENABLED=false

# Sentry DSN for error tracking
# SENTRY_DSN=

# =============================================================================
# Backup & Maintenance
# =============================================================================
# Auto-backup database (hours)
# AUTO_BACKUP_INTERVAL=24

# Backup retention days
# BACKUP_RETENTION_DAYS=30
