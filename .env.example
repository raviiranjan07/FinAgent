# FinAgent Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=finagent
POSTGRES_USER=finagent
POSTGRES_PASSWORD=finagent_secret

# Full database URL (used by Python app)
DATABASE_URL=postgresql://finagent:finagent_secret@localhost:5432/finagent

# Enable SQL query logging (for debugging)
SQL_DEBUG=false

# Enable database adapter in pipeline (set to true when PostgreSQL is running)
DATABASE_ENABLED=false

# =============================================================================
# Ollama Configuration
# =============================================================================
# Ollama API endpoint
OLLAMA_URL=http://localhost:11434

# LLM model for content generation
MODEL_NAME=llama3

# Embedding model for vector similarity (uses sentence-transformers, not Ollama)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM settings
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# =============================================================================
# Application Settings
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum events to fetch per RSS source
MAX_EVENTS_PER_SOURCE=5

# =============================================================================
# Pre-MVP Settings (for future use)
# =============================================================================
# Evaluation UI port
# EVAL_UI_PORT=8000

# Content approval required before publishing
# REQUIRE_APPROVAL=true

# =============================================================================
# MVP Settings (for future use)
# =============================================================================
# Twitter/X API credentials
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# LinkedIn API credentials
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
