# FinAgent API Dockerfile
# FastAPI backend server

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better caching)
# Use lightweight API requirements (excludes sentence-transformers/PyTorch/CUDA)
COPY requirements-api.txt .

# Install Python dependencies (CPU only, no CUDA)
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 finagent && chown -R finagent:finagent /app
USER finagent

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/api/health')" || exit 1

# Run the API server
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8001"]
